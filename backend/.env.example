[TEMPLATE]
# ------------------------------------------------------------------
# UniVerse backend configuration
# ------------------------------------------------------------------

# Database engine: mysql | postgres | sqlite
# - postgres (default): matches backend/docker-compose.yml — run
#   `docker compose up -d` and you're set.
# - mysql: point at your (remote) server using the settings below.
# - sqlite: local file fallback, stored in backend/data/universe.sqlite
#
# When you set DATABASE_URL (Option A below), the engine is inferred from the
# URL automatically — you can leave DB_TYPE commented out.
DB_TYPE=postgres

# ==========================================================================
# OPTION A (easiest): paste a full connection string. Works with PostgreSQL
# hosted providers (Neon, Supabase, Railway, Render...) and MySQL hosts.
# It overrides the individual DB_* settings below, and the engine is inferred
# from the URL scheme (postgres:// or mysql://).
# Example:  postgres://user:password@host:5432/database?sslmode=require
# ==========================================================================
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/universe

# ==========================================================================
# OPTION B: individual settings (used when DATABASE_URL is not set)
# Defaults below match backend/docker-compose.yml.
# ==========================================================================
DB_HOST=localhost
DB_PORT=5432         # 3306 for MySQL, 5432 for PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=universe

# Set to true when connecting to a remote Postgres that requires TLS
# (most hosted providers — Neon, Supabase — require it).
DB_SSL=false

# SQLite file location (used when DB_TYPE=sqlite)
DB_FILE=data/universe.sqlite

# Auto-create/update tables on startup (safe for development; disable in prod
# and manage the schema via schema.sql instead)
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------
# Email (password reset + verification codes)
# ------------------------------------------------------------------
# Set RESEND_API_KEY to send real email via Resend (https://resend.com — free
# tier available). Without it the app runs in DEMO MODE: codes and reset links
# are printed to the backend console and returned to the client so the flow
# can still be completed locally.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=UniVerse <onboarding@resend.dev>

# Public URL of the frontend, used to build password-reset links
# APP_URL=http://localhost:3000

# Comma-separated origins allowed to call the API (your hosted frontend).
# Defaults to http://localhost:3000.
# CORS_ORIGINS=https://your-frontend.example.com

# Server port
PORT=7777
